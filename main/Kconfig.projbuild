menu "MAX3010x Logger"

    menu "I2C (MAX3010x)"
        config APP_I2C_SDA_GPIO
            int "SDA GPIO"
            range 0 48
            default 8
            help
                I2C SDA pin connected to MAX3010x SDA.

        config APP_I2C_SCL_GPIO
            int "SCL GPIO"
            range 0 48
            default 9
            help
                I2C SCL pin connected to MAX3010x SCL.

        config APP_I2C_FREQ_HZ
            int "I2C frequency (Hz)"
            range 10000 400000
            default 50000
            help
                Lower frequencies are more robust with long wires / weak pull-ups.
                50kHz is a safe default for breadboards.

        config APP_I2C_ENABLE_INTERNAL_PULLUPS
            bool "Enable internal pull-ups"
            default y
            help
                Enables ESP32-S3 internal pull-ups on SDA/SCL.
                External 4.7k pull-ups to 3.3V are still strongly recommended.

        config APP_I2C_RECOVERY_ENABLED
            bool "Enable I2C bus recovery (SCL toggling)"
            default y
            help
                If the bus gets stuck (SDA low) or repeated transactions fail, the firmware will:
                - delete the I2C driver
                - toggle SCL to release the slave
                - re-init I2C and re-configure the sensor

        config APP_SUPPRESS_IDF_I2C_MASTER_ERRORS
            bool "Suppress ESP-IDF i2c.master error logs"
            default y
            help
                ESP-IDF prints error logs for each failed I2C transaction. If enabled, those logs are muted
                and the app will print its own rate-limited warnings instead.
    endmenu

    menu "Status LED"
        choice APP_STATUS_LED_PRESET
            prompt "Board LED preset"
            default APP_STATUS_LED_PRESET_DEVKITC1
            help
                If your LED is on-board ("embedded"), pick a preset for your dev board so you don't need to
                know the GPIO. If your board isn't listed, choose Custom and set the LED wiring manually.

            config APP_STATUS_LED_PRESET_DEVKITC1
                bool "ESP32-S3 DevKitC-1 onboard RGB (WS2812 on GPIO48)"

            config APP_STATUS_LED_PRESET_CUSTOM
                bool "Custom (set LED type/pins below)"

            config APP_STATUS_LED_PRESET_DISABLED
                bool "Disabled"
        endchoice

        choice APP_STATUS_LED_MODE
            prompt "LED type"
            default APP_STATUS_LED_WS2812
            depends on APP_STATUS_LED_PRESET_CUSTOM
            help
                Select how to drive the on-board status LED.

            config APP_STATUS_LED_WS2812
                bool "WS2812 / addressable RGB (via led_strip)"

            config APP_STATUS_LED_GPIO_DUAL
                bool "Two GPIO LEDs (RED + GREEN)"

            config APP_STATUS_LED_DISABLED
                bool "Disabled"
        endchoice

        config APP_STATUS_LED_WS2812_GPIO
            int "WS2812 GPIO"
            range 0 48
            default 48
            depends on APP_STATUS_LED_WS2812 && APP_STATUS_LED_PRESET_CUSTOM
            help
                GPIO connected to the WS2812 data input.

        config APP_STATUS_LED_GPIO_RED
            int "RED LED GPIO"
            range 0 48
            default 1
            depends on APP_STATUS_LED_GPIO_DUAL && APP_STATUS_LED_PRESET_CUSTOM
            help
                GPIO connected to the RED indicator LED.

        config APP_STATUS_LED_GPIO_GREEN
            int "GREEN LED GPIO"
            range 0 48
            default 2
            depends on APP_STATUS_LED_GPIO_DUAL && APP_STATUS_LED_PRESET_CUSTOM
            help
                GPIO connected to the GREEN indicator LED.

        config APP_STATUS_LED_GPIO_ACTIVE_LOW
            bool "GPIO LEDs are active-low"
            default y
            depends on APP_STATUS_LED_GPIO_DUAL && APP_STATUS_LED_PRESET_CUSTOM
            help
                Enable if the LED turns ON when the GPIO is driven LOW (common-anode LEDs).
    endmenu

    config APP_USB_CDC_CONSOLE
        bool "Send ESP_LOG output to USB CDC (native USB)"
        default y
        help
            If enabled, ESP_LOG output is routed to the TinyUSB CDC interface (COM port).
            This avoids depending on esp_tinyusb console helper APIs that vary across versions.

endmenu

