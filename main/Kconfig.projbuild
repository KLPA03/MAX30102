menu "Example Configuration"

    config EXAMPLE_I2C_PORT_NUM
        int "I2C port number"
        range 0 1
        default 0
        help
            ESP32-S3 typically uses I2C port 0.

    config EXAMPLE_I2C_SDA
        int "I2C SDA GPIO"
        range -1 48
        default 8

    config EXAMPLE_I2C_SCL
        int "I2C SCL GPIO"
        range -1 48
        default 9

    config EXAMPLE_I2C_FREQ_HZ
        int "I2C clock frequency (Hz)"
        range 10000 1000000
        default 400000

    config EXAMPLE_MAX30101_I2C_ADDR
        hex "MAX30101 I2C address"
        default 0x57

    config EXAMPLE_LOG_INTERVAL_MS
        int "CSV log interval (ms)"
        range 10 60000
        default 100

    config EXAMPLE_LOG_ENABLED_DEFAULT
        bool "Start logging automatically"
        default y

endmenu

