# TinyUSB MSC (Mass Storage Class)
CONFIG_TINYUSB_MSC_ENABLED=y

# TinyUSB CDC (Serial over USB, for idf.py monitor)
CONFIG_TINYUSB_CDC_ENABLED=y

# Custom partition table
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"

# Wear levelling: 512B sectors (fits MSC/FAT well)
CONFIG_WL_SECTOR_SIZE_512=y
CONFIG_WL_SECTOR_MODE_PERF=y

# FATFS options (long file names)
CONFIG_FATFS_LFN_HEAP=y

# App defaults (see `idf.py menuconfig` -> "MAX3010x Logger")
CONFIG_APP_I2C_SDA_GPIO=8
CONFIG_APP_I2C_SCL_GPIO=9
CONFIG_APP_I2C_FREQ_HZ=50000
CONFIG_APP_I2C_ENABLE_INTERNAL_PULLUPS=y
CONFIG_APP_I2C_RECOVERY_ENABLED=y
CONFIG_APP_SUPPRESS_IDF_I2C_MASTER_ERRORS=y

CONFIG_APP_STATUS_LED_WS2812=y
CONFIG_APP_STATUS_LED_WS2812_GPIO=48

CONFIG_APP_USB_CDC_CONSOLE=y

